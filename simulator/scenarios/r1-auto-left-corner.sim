# Robot 1, auto 4 "R1 Left Corner: Wait for Tip, Launch, Park" (autos/LeftCornerWaitLaunchAndPark.java), as RED.
# In a match our partner's shots tip the HIVE; here four POLLEN dropped into the up CELL tip it, 5 s after START.
# Then the CELL on the left is up: the camera sees it, the robot aims, fires all four, and parks beside
# the left corner of our LOADING ZONE.
# Run it from the ftc-helper-lib folder: ./gradlew :sim:scenario -Pfile=../simulator/scenarios/r1-auto-left-corner.sim
robot ../robot.properties
set scatter realistic
init "R1 Left Corner: Wait for Tip, Launch, Park"
press g1.b                                 # RED
wait 0.5
expect robot x = -58.4 0.3
expect robot y = -58.4 0.3
expect robot heading = -44.7 1             # the front (the ramp) at the HIVE's left CELL
start
wait 4
expect launched = 0                        # no tip yet: it waits
set piece POLLEN 18.6 -12.75 62
set piece POLLEN 18.6 -12.75 66
set piece POLLEN 18.6 -12.75 70
set piece POLLEN 18.6 -12.75 74
expect within 6 tips "Red" >= 1            # the pieces drop in, then the HIVE takes 2 s to tip
expect within 18 launched >= 4
expect within 30 phase STOPPED
wait 0.5
print screen
expect screen has "Wait for the tip: done"
expect screen has "To the LOADING ZONE: done"
expect screen not "skipped"
expect screen not "timed out"
expect screen not "cut short"
expect bumped none
expect points "red" >= 8                   # LEAVE 3 + PARK 5 (and the shots that went in)
print robot
